    "stamp": "node --env-file-if-exists=.env partes/josecadenax/src/agent.js",
    "verify": "node --env-file-if-exists=.env partes/josecadenax/src/verify-cli.js",
    "mcp": "node partes/josecadenax/src/mcp-server.js",
