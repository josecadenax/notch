# Account that receives the 0.01 USDC per stamp (public key only, needs a USDC trustline)
PAYEE_PUBLIC=
# Account that signs the stamp transactions and pays their XLM fee
STAMPER_PUBLIC=
STAMPER_SECRET=
# Wallet of the agent that pays for stamps (used by the client, never by the server).
# For just the paying wallet run: npm run setup:accounts -- --agent-only
AGENT_SECRET=
# Optional
PORT=3001
API_URL=http://localhost:3001
SPEND_CAP=$0.02
# Account the agent insists on paying. Required when API_URL is not localhost
# (already pinned for the public Notch API). See docs/mcp.md
EXPECTED_PAYEE=
# x402 facilitator that verifies and settles payments. Default: the x402.org test facilitator.
# For OpenZeppelin Channels (testnet): FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
# and a key from https://channels.openzeppelin.com/testnet/gen in FACILITATOR_API_KEY.
FACILITATOR_URL=
FACILITATOR_API_KEY=
# Network. Testnet (test money) is the default. Mainnet uses REAL money and needs both lines, see docs/mainnet.md
STELLAR_NETWORK=
NOTCH_ALLOW_MAINNET=
# Soroban RPC of your own. Required on mainnet for the paying client (SDF runs none).
SOROBAN_RPC_URL=
